<?xml version="1.0" encoding="utf-8"?>
<!-- Golden Hour's icon (web/icon.svg, the iPhone AppIcon): the family's C as a sun setting on the horizon.
     The sky and ground are the background; the sun and the horizon lines are the foreground, inside the safe
     zone; the monochrome layer is the same mark for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
